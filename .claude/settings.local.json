      "Task",
      "Bash(npm run *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(cd *)",
      "Write(./.claude/tmp/**)",
      "Read(~/.zshrc)",
      "Read(~/.bashrc)",
      "mcp__figma-online__get_screenshot",
      "mcp__figma-online__get_design_context",
      "mcp__figma-online__get_variable_defs",
      "mcp__figma-online__get_metadata",
      "mcp__figma-online__get_code_connect_map",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
